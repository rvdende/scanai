# Copy to .env and fill in. scanai reads .env from the directory it is run in
# (or one above it), then from the project directory. Real environment variables
# and command-line options take precedence.

# The scanner's IP address or hostname (required; same as --host).
SCANAI_HOST=192.168.1.50

# Ollama server used for classification (optional; same as --ollama).
#SCANAI_OLLAMA=http://localhost:11434
